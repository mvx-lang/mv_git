SUBROUTINE GIT.LOG
$IFDEF MVX
OUT = ""
CALL GITLOG(".git", "20", OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
REPO = @PATH : "/.git"
R = CALLC GITLOG(REPO, "20")
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN