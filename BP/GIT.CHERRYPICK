* /**
*  * @file GIT.CHERRYPICK
*  * @version 1.0
*  */
SUBROUTINE GIT.CHERRYPICK
CALL GIT.SENT(S)
CM = FIELD(S, " ", 3)
IF CM = "" THEN
   PRINT "usage: GIT CHERRY-PICK commit"
   RETURN
END
$IFDEF MVX
OUT = ""
CALL GITCHERRYPICK(".git", CM, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("CHERRYPICK", 2, REPO, CM, "", "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)                ;* the cherry-pick result
CALL GITUDT.CHECKOUT(REPO)           ;* re-materialise the new HEAD natively
$ENDIF
RETURN