* mv_git — record-git for MultiValue.
* Copyright (C) 2026 Gordon Heydon.
*
* SPDX-License-Identifier: GPL-2.0-only
* /**
*  * @file GITUDT.CHECKOUT
*  * @version 1.0
*  */
* GITUDT.CHECKOUT(repo) — the UniData (Model B) CHECKOUT: materialise the git
* HEAD into this account.  CREATE.FILE each file from its open-form %FILE% control
* (DIR/hash), then WRITE every record back on the current session (C reads the git
* objects via GITFILES/GITCAT; the writes are native).  Then detect index changes
* (#11) and, if any, prompt to rebuild.
SUBROUTINE GITUDT.CHECKOUT(REPO)
$IFNDEF MVX
*     Which VOC records are the SYSTEM's, so the delete-extras pass below does
*     not remove the ones the commit deliberately never carried (mv_git#46).
*     Without this a pull strips the destination account's own VOC — the
*     symptom is a stock verb such as CT vanishing after a clone or pull.
      CALL GIT.OBJ("STOCKPREP", 1, REPO, "", "", "", "", SPOUT)
*     And open it for THIS program too: the delete pass below is BASIC, so it
*     asks the master directly rather than through the engine.
      STKOK = 0
*     No guard here: this file is already inside IFNDEF MVX, and an inner
*     ENDIF would close it and drop the rest of the program from the build.
*     GIT.STOCK holds the platform half — GETENV is UniData-only and does not
*     even PARSE on UniVerse — and answers "" there, so STKOK stays 0 and the
*     type list below still applies, exactly as it did before.
      SPATH = ""
      CALL GIT.STOCK(REPO, SPATH)
      IF SPATH # "" THEN
         OPEN "VOC" TO SVOCF THEN
            SPP = ""
            SPP<1> = "F"
            SPP<2> = FIELD(SPATH, CHAR(254), 1)
            SPP<3> = FIELD(SPATH, CHAR(254), 2)
            WRITE SPP ON SVOCF, "%GITSTOCK%"
            OPEN "%GITSTOCK%" TO STKF THEN STKOK = 1
         END
      END
   AM = CHAR(254) ; LF = CHAR(10)
   NREST = 0 ; NFC = 0 ; NDEL = 0 ; FCTL = ".DICT/%FILE%" ; LC = LEN(FCTL)
   IXCTL = ".DICT/%INDEXES%" ; LIC = LEN(IXCTL)
   CALL GIT.OBJ("FILES", 1, REPO, "", "", "", "", PATHS)
   NP = DCOUNT(PATHS, AM)
*  pass 1 - create each file from its %FILE% control (open format)
*
*  NEVER CREATE.FILE A FILE THAT IS ALREADY THERE.  CREATE.FILE is interactive:
*  asked to make a file that exists, it asks whether to recreate it, and nothing
*  here answers.  The prompt then eats whatever the session had queued next and
*  the file is left HALF-BUILT — a dictionary with no data part — after which
*  every OPEN of it in this session fails and its records are silently skipped.
*
*  Which is why a checkout into an EMPTY account was always fine and a pull into
*  a live one was not: a clone creates files that are genuinely absent, while a
*  pull re-runs this pass over an account that already has them.  The pulled
*  record was simply never written — the file it belonged to could not be opened
*  — and both `pull` and the checkout reported success (mv_git#65).
*
*  The same guard DO.CREATEFILE has carried all along, for the same stated
*  reason; this is the path that never got it.  A file that exists needs no
*  creating, and its geometry is create-time metadata that a checkout must not
*  act on anyway.
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      IF LP > LC AND P[LP-LC+1, LC] = FCTL THEN
         BASE = P[1, LP-LC]
         EXISTS = 0
         OPEN BASE TO CFEXV THEN EXISTS = 1
         IF NOT(EXISTS) THEN
            CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", TY)
*           The class is LINE ONE of the control; the lines after it are the
*           registry's `key = value` parameters (mv_git#15).  CAT returns the
*           blob with newlines already marks, so line 1 is <1> — taking the
*           whole blob left an extended control matching neither arm below, and
*           the file was recreated as a default hash whatever it actually was.
            TY = TRIM(TY<1>)
            IF TY = "DIR" THEN
               EXECUTE "CREATE.FILE DIR ":BASE CAPTURING JUNK
            END ELSE
               MODL = FIELD(TY, " ", 2) ; IF NUM(MODL) = 0 THEN MODL = "11"
               EXECUTE "CREATE.FILE ":BASE:" ":MODL:",2" CAPTURING JUNK
            END
            NFC += 1
         END
      END
   NEXT I
*  pass 1b - restore the account's Q-pointers from the %QPOINTERS% control.
*  They are account attributes with nothing to re-derive them from (unlike the
*  file and verb pointers, which come back from %FILE% and cataloging), so
*  without this a materialised account loses them.  One
*  "name<TAB>account<TAB>file" line each; the target account has to exist here,
*  which is the same condition as when the pointer was written by hand.
   NQR = 0
   FOR I = 1 TO NP
      IF PATHS<I> = "%QPOINTERS%" THEN
*        GIT.OBJ("CAT"), not a raw CALLC.  This file is guarded IFNDEF MVX,
*        which is true on UniVerse as well as UniData — and CALLC is a UniData
*        statement UniVerse parses as an ARRAY REFERENCE, so it failed to
*        compile there with "Array 'GITCAT' never dimensioned", the verb never
*        cataloged, and 25 of 29 tests failed at once.  DECISIONS.md records the
*        rule this broke: guard on the POSITIVE platform, and reach the engine
*        through GIT.OBJ, which dispatches CallC on UniData and the background
*        process on UniVerse.  The rest of this file already does exactly that.
         CALL GIT.OBJ("CAT", 2, REPO, "%QPOINTERS%", "", "", "", QPG)
         OPEN "VOC" TO QVF THEN
            NQL = DCOUNT(QPG, LF)
            FOR QI = 1 TO NQL
               QL = FIELD(QPG, LF, QI)
               IF TRIM(QL) # "" THEN
                  QID = FIELD(QL, CHAR(9), 1)
                  QACC = FIELD(QL, CHAR(9), 2)
                  QFIL = FIELD(QL, CHAR(9), 3)
                  IF QID # "" AND QACC # "" THEN
                     WRITE ("Q" : AM : QACC : AM : QFIL) ON QVF, QID
                     NQR += 1
                  END
               END
            NEXT QI
         END
      END
   NEXT I
   IF NQR > 0 THEN PRINT NQR : " Q-pointer(s) restored"
*  pass 2 - WRITE every record (skip the descriptor and the %FILE% controls)
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      IF P = ".mv-account" OR P = ".udt" OR P = ".mvx" THEN GOTO NEXTREC
      IF LP > LC AND P[LP-LC+1, LC] = FCTL THEN GOTO NEXTREC
      IF LP > LIC AND P[LP-LIC+1, LIC] = IXCTL THEN GOTO NEXTREC
      SL = INDEX(P, "/", 1)
      IF SL = 0 THEN GOTO NEXTREC
      FN = P[1, SL-1] ; ID = P[SL+1, LP]
      CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", REC)
      LFN = LEN(FN)
      IF LFN > 5 AND FN[LFN-4, 5] = ".DICT" THEN
         OPEN "DICT", FN[1, LFN-5] TO FV ELSE GOTO NEXTREC
      END ELSE
         OPEN FN TO FV ELSE GOTO NEXTREC
      END
      WRITE REC ON FV, ID
      NREST += 1
NEXTREC:
   NEXT I
*  pass 2b - delete live records no longer in HEAD (branch switch / merge removals).
*  Data files only, and never the %-prefixed controls (%FILE%/%INDEXES%).  For each
*  data file HEAD touches, build its HEAD id-set and DELETE any live id not in it.
   DONE = AM
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      SL = INDEX(P, "/", 1)
      IF SL = 0 THEN GOTO NEXTDEL
      FN = P[1, SL-1] ; LFN = LEN(FN)
      IF LFN > 5 AND FN[LFN-4, 5] = ".DICT" THEN GOTO NEXTDEL   ;* skip dictionaries
      IF INDEX(DONE, AM:FN:AM, 1) # 0 THEN GOTO NEXTDEL         ;* file already handled
      DONE = DONE : FN : AM
      HW = AM
      FOR J = 1 TO NP
         Q = PATHS<J> ; LQ = LEN(Q) ; SQ = INDEX(Q, "/", 1)
         IF SQ > 0 THEN
            IF Q[1, SQ-1] = FN THEN
               QID = Q[SQ+1, LQ]
               IF QID # "" AND QID[1, 1] # "%" THEN HW = HW : QID : AM
            END
         END
      NEXT J
      OPEN FN TO DV ELSE GOTO NEXTDEL
*     A select-list VARIABLE, not the numbered list 9: UniVerse rejects
*     `SELECT DV TO 9` ("option 'S' requires variable name"), while both
*     platforms accept a variable, so this is the portable spelling.
      SELECT DV TO DLIST
      LOOP
         READNEXT LID FROM DLIST ELSE EXIT
         IF INDEX(HW, AM:LID:AM, 1) = 0 THEN
            GOSUB KEEPCHK
            IF KEEP = 0 THEN
               DELETE DV, LID
               NDEL += 1
            END
         END
      REPEAT
NEXTDEL:
   NEXT I
*  pass 3 - DETECT index changes only (#11)
   IXWANT = ""
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      IF LP > LIC AND P[LP-LIC+1, LIC] = IXCTL THEN
         BASE = P[1, LP-LIC]
         CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", IXL)
         LIVE = "" ; OPEN BASE TO IXOV THEN LIVE = INDICES(IXOV)
         CHG = 0 ; DW = AM:IXL:AM ; LW = AM:LIVE:AM
         FOR J = 1 TO DCOUNT(IXL, AM)
            IF INDEX(LW, AM:TRIM(IXL<J>):AM, 1) = 0 THEN CHG = 1
         NEXT J
         FOR J = 1 TO DCOUNT(LIVE, AM)
            IF INDEX(DW, AM:TRIM(LIVE<J>):AM, 1) = 0 THEN CHG = 1
         NEXT J
         IF CHG THEN IXWANT<-1> = BASE
      END
   NEXT I
*  NFC counts files CREATED, not files touched — so a pull into an existing
*  account correctly says 0, and "across 0 file(s)" read like a bug every time.
   PRINT NREST : " record(s) restored, " : NFC : " file(s) created"
   IF NDEL > 0 THEN PRINT NDEL : " stale record(s) removed"
*  The stock pointer exists only for the length of the checkout; left behind it
*  would look like one of the account's own VOC records to the next add.
   IF STKOK THEN
      DELETE SVOCF, "%GITSTOCK%"
      STKOK = 0
   END
   GOSUB IXPROMPT
   RETURN
* KEEPCHK — is this live record one that must NEVER be deleted as "stale"?
* Open format deliberately DROPS the VOC pointer records (GIT.ADD: V/K, F/LF/DF/
* DIR, Q/X/R) as machine-specific, so they are absent from HEAD by design — and
* pass 2b, which deletes whatever HEAD does not carry, would therefore delete the
* account's verbs and file pointers and leave it unable to run a command.  Skip
* those types.  Safe in both formats: a pointer that IS captured is in HEAD, so it
* was never a delete candidate in the first place.  Mirrors GIT.ADD's drop list —
* the two must stay in step.
KEEPCHK:
   KEEP = 0
   IF FN # "VOC" THEN RETURN
*  ASK THE STOCK ACCOUNT, DO NOT GUESS BY TYPE.  The type list below is a list
*  of guesses, and it was wrong: measured on UniData 8.3, CT is type "PA" (a
*  paragraph), not "V" — so a clone deleted CT and ~92 others like it, and the
*  account lost stock verbs the commit had never claimed to carry (mv_git#46).
*  Whatever a fresh account of this release already holds is the system's, at
*  any type at all, so the master VOC is the authority and this test is exact.
*
*  By id, not by content, and that is deliberate: a stock record this account
*  EDITED differs from stock, so it was committed, so it is in HW and the
*  caller never asks about it.  An id-only test therefore protects nothing that
*  should have been removed, and it costs no second record read.
   IF STKOK THEN
      READ SKR FROM STKF, LID THEN
         KEEP = 1
         RETURN
      END
   END
   READ KR FROM DV, LID ELSE RETURN
   KT = TRIM(KR<1>)
   IF KT = "V" OR KT = "K" THEN KEEP = 1
   IF KT = "F" OR KT = "LF" OR KT = "DF" OR KT = "DIR" THEN KEEP = 1
   IF KT = "Q" OR KT = "X" OR KT = "R" THEN KEEP = 1
   RETURN
*  If any file's indexes changed, list them and ask before rebuilding (#11).
IXPROMPT:
   NW2 = DCOUNT(IXWANT, AM)
   IF NW2 = 0 THEN RETURN
   PRINT "Indexes have changed for " : NW2 : " file(s):"
   FOR I = 1 TO NW2
      BASE = IXWANT<I>
      CALL GIT.OBJ("CAT", 2, REPO, BASE:IXCTL, "", "", "", IXL)
      PRINT "  " : BASE : " (" : CONVERT(AM, " ", TRIM(IXL)) : ")"
   NEXT I
   PRINT "Rebuild them now? (Y/N) " :
   INPUT ANS
   IF UPCASE(ANS)[1,1] # "Y" THEN
      PRINT "Indexes not rebuilt; run GIT CHECKOUT again to rebuild."
      RETURN
   END
   NIX = 0
   FOR I = 1 TO NW2
      BASE = IXWANT<I>
      CALL GIT.OBJ("CAT", 2, REPO, BASE:IXCTL, "", "", "", IXL)
      NF2 = DCOUNT(IXL, AM)
      FOR J = 1 TO NF2
         FLD = TRIM(IXL<J>)
         IF FLD # "" THEN
            DATA ""
            EXECUTE "CREATE.INDEX ":BASE:" ":FLD CAPTURING JUNK
            NIX += 1
         END
      NEXT J
      IF NF2 > 0 THEN EXECUTE "BUILD.INDEX ":BASE:" ALL" CAPTURING JUNK
   NEXT I
   PRINT NIX : " index(es) rebuilt"
   RETURN
$ENDIF
RETURN