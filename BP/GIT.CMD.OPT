SUBROUTINE GIT.CMD.OPT(SPEC, SHORT, LONG, TAKESVAL, DFLT, HELP)
SPEC<-1> = SHORT : @VM : LONG : @VM : TAKESVAL : @VM : DFLT : @VM : HELP
RETURN