*
* git's bundled cut-down cmd (GIT.CMD.*), used when the full mv_cmd is not
* installed.  BP/GIT probes GIT.HAS("cmd") and dispatches through the real CMD.*
* when it is, else through these — resolved by name (CALL @), so there is no
* catalog-override to reason about.
* /**
*  * @file GIT.CMD.ADD
*  * @version 1.0
*  */
* CMD.ADD(subcommand, description, handler-subroutine)
SUBROUTINE GIT.CMD.ADD(SUB, DESC, HANDLER)
COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS, CFLAGS
CSUBS<-1> = OCONV(SUB, "MCU")
CDESCS<-1> = DESC
CHANDLERS<-1> = HANDLER
RETURN