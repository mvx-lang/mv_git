*  * @version 1.0
*  */
SUBROUTINE GIT.PULL
CALL GIT.SENT(S)
REM = FIELD(S, " ", 3)
BR = FIELD(S, " ", 4)
$IFDEF MVX
OUT = ""
CALL GITPULL(".git", REM, BR, OUT)
PRINT OUT
$ELSE
PERFORM "UDT.OPTIONS 88 ON"
REPO = @PATH : "/.git"
R = CALLC GITPULL(REPO, REM, BR)
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN