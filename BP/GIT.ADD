* /**
*  * @file GIT.ADD
*  * @version 4.1
*  */
SUBROUTINE GIT.ADD
      $INCLUDE BP.INC PLATFORM.H
*     The stock-account baseline (mv_git#46); STOCKID is the temporary VOC
*     pointer STOCKOPEN lays down and STOCKCLOSE takes away again.
      STKOK = 0
      STOCKID = "%GITSTOCK%"
* The include is REQUIRED now, and was not before: the two-way IFDEF MVX /
* ELSE / ENDIF runs its ELSE arm whether or not any define is in scope, so
* this file worked without ever including PLATFORM.H.  Inlining keeps that shape
* but makes the define load-bearing, and a handler that silently compiles to
* nothing is what cost an afternoon on GIT CLONE (mv_git#52).
* -A/--all stages every changed record (also '.'); DICT addresses a dictionary;
* otherwise a positional file {record}.  Flags are decoded by the cmd dispatch
* (GIT.CMD.FLAG A/o).  The udt Model-B ADD re-reads the raw sentence itself.
$IFDEF MVX
CALL GIT.CMD.HAS("all", ALLF)
CALL GIT.CMD.ARG(1, A1)
IF ALLF OR A1 = "." THEN
   OUT = ""
   CALL GITADDALL(".git", OUT)
   PRINT OUT
   RETURN
END
IF A1 = "DICT" THEN
   CALL GIT.CMD.ARG(2, DF)
   FN = DF : ".DICT"
   CALL GIT.CMD.ARG(3, ID)
END ELSE
   FN = A1
   CALL GIT.CMD.ARG(2, ID)
END
IF FN = ".DICT" OR FN = "" THEN
   PRINT "usage: GIT ADD {DICT} file {record}"
   RETURN
END
OUT = ""
CALL GITADD(".git", FN, ID, OUT)
PRINT OUT
$ELSE
* Inlined from GITUDT.ADD, which had exactly one caller — this one.  Its
* parameters were (REPO, S), the same names the caller already uses, so the body
* below is byte-identical to the version verified on all three platforms.
CALL GIT.SENT(S)
CALL GIT.REPO(REPO)
   AM = CHAR(254) ; VM = CHAR(253) ; LF = CHAR(10)
*  Where this account sits in its repository.  "" when the account IS the repo
*  root — which is every single-account package, so those paths are unchanged.
*  Below a root it is "<account>/", and every path staged here carries it, so
*  two accounts in one repository cannot both claim CUST/C1.
   CALL GIT.PREFIX(PFX)
   ARG3 = FIELD(S, " ", 3)
   OPENFMT = 0
   IF INDEX(S, " -o", 1) # 0 OR INDEX(S, " --open", 1) # 0 THEN OPENFMT = 1
   IF ARG3 = "-A" OR ARG3 = "." OR ARG3 = "--all" THEN
      SKIPOBJ = 1
      GOSUB ADDALL
      PRINT NSTAGED : " record(s) staged across " : NFILES : " file(s)"
      IF NSKIP > 0 THEN PRINT NSKIP : " virtual file(s) skipped (SQL catalog / DataView — no data to stage)"
   END ELSE
      FILE = ARG3 ; ISVOC = 0 ; NSTAGED = 0 ; SKIPOBJ = 0 ; BLANKET = 0
*     A NAMED RECORD stages just that record.  This arm ignored the id entirely
*     and staged the whole file — `GIT ADD VOC ZZPULL` reported "617 record(s)
*     staged" — while MVX and UniVerse both stage the one record named.  Three
*     implementations, and this was the one that had never been asked.
      ONEID = FIELD(S, " ", 4)
      IF ONEID # "" AND ONEID[1,1] # "-" THEN
         OPEN FILE TO OF1 ELSE
            PRINT "GIT: cannot open " : FILE
            RETURN
         END
         READ OREC FROM OF1, ONEID THEN
            CALL GIT.OBJ("STAGE", 4, REPO, PFX:FILE, ONEID, OREC, "", OBJOUT)
            PRINT "1 record(s) staged"
         END ELSE
            PRINT "GIT: no record " : ONEID : " in " : FILE
         END
      END ELSE
         GOSUB STAGEDATA
         PRINT NSTAGED : " record(s) staged"
      END
   END
*  Write the staged index to disk before returning.  It is the handover to
*  COMMIT, which reads it from disk in a separate process — so a batch still
*  held in memory here is a commit of nothing there.
   CALL GIT.OBJ("FLUSH", 1, REPO, "", "", "", "", OBJOUT)
*  RECORDS DELETED from a live file.  Staging only ever ADDS, so a record removed
*  from the account stayed in the index and went on being committed — and a clone
*  brought it back.  status has always reported these correctly, so the two
*  disagreed about the same account.  The C add reconciles this per file; this is
*  that, for the platforms whose add is BASIC.
*
*  AFTER THE FLUSH, not during the walk.  Staging batches in memory and only the
*  flush writes it; unstaging edits the index ON DISK, so a reconcile done inside
*  the loop was silently undone the moment the batch landed on top of it.  That
*  is why this worked on UniData (CallC flushes per op) and not on UniVerse.
   IF BLANKET THEN
      NRC = DCOUNT(FILES, AM)
      FOR RK = 1 TO NRC
         RCBASE = FIELD(FILES<RK>, VM, 1)
         RCFILE = RCBASE            ; GOSUB RECONCILE
         RCFILE = RCBASE : ".DICT"  ; GOSUB RECONCILE
      NEXT RK
   END ELSE
      RCFILE = FILE           ; GOSUB RECONCILE
      RCFILE = FILE : ".DICT" ; GOSUB RECONCILE
   END
*  FILES THAT ARE GONE.  The walk above stages what EXISTS, so a file deleted
*  from the account is never visited and its records stay staged for ever —
*  committed again every time, and brought back whole by a clone.  %FILE% is the
*  file's existence in git, so when it goes the file goes: PRUNE drops every
*  record under <file>/ and <file>.DICT/.  Only on a blanket add — naming one
*  file is about that file.  The engine does exactly this inside its own C
*  add; calling the same primitive here is what keeps the two agreeing.
*  FILES is the list this walk actually found, and it has to be US who says so:
*  mvgitd has no record backend of its own — it cannot open the account — so
*  asked to decide what is live it would answer "nothing" and unstage the lot.
   IF BLANKET THEN
      PRUNEOUT = ""
      CALL GIT.OBJ("PRUNE", 2, REPO, FILES, "", "", "", PRUNEOUT)
      IF PRUNEOUT # "" THEN CALL GIT.ECHO(PRUNEOUT)
   END
*  A record whose id cannot be a git path is not versioned, so say so rather
*  than let the count quietly disagree with what was committed.
   IF OBJOUT # "" THEN CALL GIT.ECHO(OBJOUT)
   RETURN
*  Stage the whole account: collect the local files from VOC first (drain the VOC
*  select before opening any file), then stage each file's data + dictionary (+
*  open-form controls when -o).
ADDALL:
   NSTAGED = 0 ; NFILES = 0 ; FILES = "" ; BLANKET = 1 ; NSKIP = 0 ; ALLF = ""
   OPEN "VOC" TO VOCF ELSE PRINT "GIT: no VOC" ; RETURN
   SELECT VOCF
   LOOP WHILE READNEXT VID DO
      READ VREC FROM VOCF, VID THEN
*        Attribute 1 is the TYPE, but it is not always the type ALONE: UniVerse
*        appends the file description a user may give at CREATE.FILE time, so a
*        described file reads "F Customer master" and an exact match against
*        "F" makes it invisible to this scan — the file is simply never staged,
*        with no error.  Take the first token, and trim, so a description (or a
*        trailing space from an empty one) cannot hide a file from GIT ADD -A.
         VT = TRIM(FIELD(VREC<1>, " ", 1))
         IF VT = "F" OR VT = "DIR" THEN
            DP = VREC<2> ; DD = VREC<3> ; LOC = 1
            IF INDEX(DP,"/",1) OR DP[1,1] = "@" THEN LOC = 0
            IF INDEX(DD,"/",1) OR DD[1,1] = "@" THEN LOC = 0
*           Every file-type id is a candidate, local or not: VOC points at
*           furniture that has no file here (_ENCINFO_, _KEYSTORE_) and those
*           pointers are furniture too.  The local ones are what gets staged.
            ALLF<-1> = VID : VM : VT
            IF LOC THEN FILES<-1> = VID : VM : VT
         END
      END
   REPEAT
*  ONE set of furniture rules, for the verb and the CLI alike, and one place
*  that asks for them — GIT.FURNIDS, which `status` calls too.  This walk has to
*  be here (mvgitd has no record backend, so on UniVerse the enumeration must
*  happen in the session), but what the walk FINDS and what counts as FURNITURE
*  are different questions and only the first needs BASIC.  GIT.ADD used to test
*  `_X_` and `&X&` inline and know none of the names, so the verb committed the
*  whole SQL catalogue while the CLI did not: 944 blobs against 76 for the same
*  stock account (mv_git#81).
   FURNIDS = ""
   CALL GIT.FURNIDS(REPO, ALLF, FURNIDS)
   IF FURNIDS # "" THEN
      KEPT = ""
      NRAW = DCOUNT(FILES, AM)
      FOR RK = 1 TO NRAW
         LOCATE(FIELD(FILES<RK>, VM, 1), FURNIDS; FPOS) ELSE KEPT<-1> = FILES<RK>
      NEXT RK
      FILES = KEPT
   END
*  The same list as bare ids, for the derived-pointer test in STAGEDATA.  A
*  LOCATE cannot see past the VM that carries each entry's type, and building it
*  once here is what keeps that test a lookup rather than a scan per record.
   FILEIDS = ""
   NIDS = DCOUNT(FILES, AM)
   FOR IK = 1 TO NIDS
      FILEIDS<-1> = FIELD(FILES<IK>, VM, 1)
   NEXT IK
   NF = DCOUNT(FILES, AM)
   FOR K = 1 TO NF
      FILE  = FIELD(FILES<K>, VM, 1)
      FTYPE = FIELD(FILES<K>, VM, 2)
      ISVOC = (FILE = "VOC")
      GOSUB STAGEDATA
      GOSUB STAGEDICT
*     %FILE% ON EVERY ADD, native as well as open.
*
*     It carries the file's GEOMETRY — its type, and for a hash file its modulo
*     and whether it is static or dynamic — which is what lets a clone recreate
*     the file as it was rather than at whatever the platform defaults to.  That
*     is the point of committing it, and it is just as true of a native commit
*     as an open one (mv_git#15).
*
*     It used to be staged only in open format.  A native repo therefore carried
*     no geometry at all, and got away with it only because a native commit also
*     keeps the platform's own VOC pointers — which are enough to recreate the
*     file on the SAME platform and no use anywhere else.
      GOSUB FILECLASS
      CALL GIT.OBJ("STAGEBLOB", 3, REPO, PFX:FILE:".DICT/%FILE%", CTL, "", "", OBJOUT)
*     Alternate-key indexes stay open-format: they are a portability feature,
*     not part of the file's shape.
      IF OPENFMT THEN
         GOSUB IXSTAGE
      END
      NFILES += 1
   NEXT K
*  The account descriptor, open or native, from the same place the CLI gets it.
*  It must not matter whether a commit was made with `udt-git` or with `GIT` —
*  the same account has to produce the same commit either way.  This used to
*  write one only under OPENFMT, so a native commit made with the verb carried
*  no descriptor at all and could not be cloned back as an account (mv_git#81).
   DFMT = "0"
   IF OPENFMT THEN DFMT = "1"
   DESCOUT = ""
   CALL GIT.OBJ("STAGEDESC", 3, REPO, PFX, DFMT, "", "", DESCOUT)
   IF DESCOUT # "" THEN CALL GIT.ECHO(DESCOUT)
   RETURN
*  One copy of this rule now, in GIT.FILECLASS — the drift check has to ask the
*  question exactly the way `add` asks it.
FILECLASS:
   CTL = ""
   CALL GIT.FILECLASS(FILE, CTL)
   RETURN
IXSTAGE:
   OPEN FILE TO IXVAR THEN
      IXL = INDICES(IXVAR)
      IF IXL # "" THEN
         IXG = IXL ; CONVERT AM TO LF IN IXG
         CALL GIT.OBJ("STAGEBLOB", 3, REPO, PFX:FILE:".DICT/%INDEXES%", IXG, "", "", OBJOUT)
      END
   END
   RETURN
STAGEDATA:
   OPEN FILE TO DF ELSE
      IF BLANKET THEN NSKIP += 1 ELSE PRINT "GIT: cannot open " : FILE
      RETURN
   END
   IF BLANKET AND ISVOC THEN GOSUB STOCKOPEN
   SELECT DF
   LOOP WHILE READNEXT RID DO
      READ RREC FROM DF, RID THEN
         DROP = 0
         IF SKIPOBJ AND INDEX(RREC, CHAR(0), 1) > 0 THEN DROP = 1
*        The account did not write this record; the system did.  A record
*        identical to the one a fresh account holds is furniture, not content
*        (mv_git#46) -- and it is compared BY CONTENT, so a stock verb this
*        account has EDITED differs and still travels.  Wholesale adds only:
*        naming a record stages it, the rule every other exclusion follows.
         IF RID = STOCKID THEN DROP = 1
         IF STKOK AND NOT(DROP) THEN
            READ SREC FROM STKF, RID THEN
               IF SREC = RREC THEN DROP = 1
            END
         END
*        A pointer to a file the furniture filter excluded points at nothing.
         IF BLANKET AND ISVOC AND FURNIDS # "" AND NOT(DROP) THEN
            LOCATE(RID, FURNIDS; FIDPOS) THEN DROP = 1
         END
*        A FILE'S OWN POINTER IS DERIVED, so it is not content in ANY form --
*        native as much as open.  CREATE.FILE writes it, DELETE.FILE removes it,
*        and <file>.DICT/%FILE% carries the geometry a checkout needs to write it
*        again (staged on every add since mv_git#15).  Committing it as well is
*        the same fact in two places, free to disagree -- and it left a native
*        repository carrying a pointer spelled for the platform that made it and
*        of no use anywhere else (mv_git#131).
*
*        ONLY A FILE THIS ACCOUNT CARRIES, which is what FILEIDS holds: an
*        F/DIR record whose data AND dict paths are bare local names, furniture
*        already subtracted.  A Q, X or R pointer is not in it and still travels
*        below -- those name another account's file, nothing here creates them,
*        no %FILE% describes them, and dropping one loses real configuration on
*        every clone (mv_git#132).
*
*        Wholesale adds only: `ADD VOC CUST` names the record and stages it, the
*        rule every other exclusion here follows.
         IF BLANKET AND ISVOC AND NOT(DROP) THEN
            RT = TRIM(FIELD(RREC<1>, " ", 1))
            IF RT="F" OR RT="LF" OR RT="DF" OR RT="DIR" THEN
               LOCATE(RID, FILEIDS; FIPOS) THEN DROP = 1
            END
         END
         IF OPENFMT AND ISVOC THEN
            RT = RREC<1>
            IF RT="V" OR RT="K" THEN DROP = 1
            IF RT="F" OR RT="LF" OR RT="DF" OR RT="DIR" THEN DROP = 1
            IF RT="Q" OR RT="X" OR RT="R" THEN DROP = 1
         END
         IF NOT(DROP) THEN
            CALL GIT.OBJ("STAGE", 4, REPO, PFX:FILE, RID, RREC, "", OBJOUT)
            NSTAGED += 1
         END
      END
   REPEAT
   GOSUB STOCKCLOSE
*  DRAIN WHAT WE OPENED.  A select list left behind is not inert on UniData:
*  ECL feeds what remains of it to the NEXT command as stacked input, so the
*  leftover ids appear as output and the command after this one — typically the
*  COMMIT — is swallowed by them and never runs (mv_git#58).  A loop that ends
*  early leaves a list, so clearing is the only reliable point, not the loop.
*  Not guarded: this is already inside the ELSE arm.  A guard nested in an
*  ELSE arm is the case the preprocessor gets wrong — its ENDIF closes the
*  ELSE, leaving the file's own ENDIF unmatched, and UniVerse then reports
*  "End of File unexpected".  (Nesting inside a plain IFNDEF is fine, as
*  GIT.AGENT does throughout; it is the ELSE arm that breaks.)
   CLEARSELECT
   RETURN
*  What a fresh account of this release holds, so it can be subtracted (#46).
*
*  UniData needs nothing stood up: `newacct` copies $UDTHOME/sys/VOC into the
*  new account verbatim, so the master IS the baseline, exact for the release
*  running.  UniData will not open a hash file by path and has no OPENPATH, but
*  a VOC F-pointer makes any path an ordinary file to OPEN.  The pointer is
*  written into the very file being scanned, so it is dropped by id above, and
*  removed again as soon as the scan ends.
*
*  Left alone on other platforms: UniVerse's template is per FLAVOUR and not a
*  readable file, so uv-git supplies the baseline to the engine instead.
STOCKOPEN:
   STKOK = 0
*  No guard here, deliberately: this is inside the ELSE arm already, and a
*  nested IFDEF would close it and drop the rest of the program.  GIT.STOCK
*  carries the platform half instead, and answers "" where there is none.
   SPATH = ""
   CALL GIT.STOCK(REPO, SPATH)
   IF SPATH # "" THEN
      SP = ""
      SP<1> = "F"
      SP<2> = FIELD(SPATH, CHAR(254), 1)
      SP<3> = FIELD(SPATH, CHAR(254), 2)
      WRITE SP ON VOCF, STOCKID
      OPEN STOCKID TO STKF THEN STKOK = 1
   END
   RETURN
STOCKCLOSE:
   IF STKOK THEN
      DELETE VOCF, STOCKID
      STKOK = 0
   END
   RETURN
*  Unstage every id git holds for RCFILE that the account no longer has.  The
*  engine says what it has (INDEXIDS) and we say what still READs — neither side
*  can do it alone: BASIC cannot see the index, and mvgitd has no record backend.
*  The READs are local, so the only traffic is one INDEXIDS and one RM per record
*  actually deleted; an account with no deletions costs a single call per file.
RECONCILE:
   IDS = ""
   CALL GIT.OBJ("INDEXIDS", 2, REPO, RCFILE, "", "", "", IDS)
   IF IDS = "" THEN RETURN
*  A dictionary is not opened by name: "CUST.DICT" is not a file, DICT CUST is.
   RCL = LEN(RCFILE)
   IF RCL > 5 AND RCFILE[RCL - 4, 5] = ".DICT" THEN
      OPEN "DICT", RCFILE[1, RCL - 5] TO RCV ELSE RETURN
   END ELSE
      OPEN RCFILE TO RCV ELSE RETURN
   END
   NID = DCOUNT(IDS, AM)
   FOR RI = 1 TO NID
      RID = IDS<RI>
*     %FILE% is SYNTHESISED from the live file's geometry, never a record — so it
*     can never be read and must never be reported gone.
      IF RID # "%FILE%" AND RID # "%INDEXES%" THEN
         READ RCHK FROM RCV, RID THEN
            NULL
         END ELSE
*           RCOUT, not OBJOUT: OBJOUT is echoed when this handler returns, so
*           borrowing it here made the reconcile's chatter the command's output.
            CALL GIT.OBJ("RM", 3, REPO, RCFILE, RID, "", "", RCOUT)
         END
      END
   NEXT RI
   RETURN
STAGEDICT:
   OPEN "DICT", FILE TO DCF ELSE RETURN
   SELECT DCF
   LOOP WHILE READNEXT RID DO
      READ RREC FROM DCF, RID THEN
         CALL GIT.OBJ("STAGE", 4, REPO, PFX:FILE:".DICT", RID, RREC, "", OBJOUT)
         NSTAGED += 1
      END
   REPEAT
   RETURN
$ENDIF
RETURN