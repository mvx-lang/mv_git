* /**
*  * @file GIT.ADD
*  * @version 4.1
*  */
SUBROUTINE GIT.ADD
CALL GIT.SENT(S)
$IFDEF MVX
A = FIELD(S, " ", 3)
IF A = "-A" OR A = "--all" OR A = "." THEN
   OUT = ""
   CALL GITADDALL(".git", OUT)
   PRINT OUT
   RETURN
END
IF A = "DICT" THEN
   FN = FIELD(S, " ", 4):".DICT"
   ID = FIELD(S, " ", 5)
END ELSE
   FN = A
   ID = FIELD(S, " ", 4)
END
IF FN = ".DICT" OR FN = "" THEN
   PRINT "usage: GIT ADD {DICT} file {record}"
   RETURN
END
OUT = ""
CALL GITADD(".git", FN, ID, OUT)
PRINT OUT
$ELSE
PERFORM "UDT.OPTIONS 88 ON"  ;* once per invocation; better: enable in the login PROC (mv_git#25)
REPO = @PATH : "/.git"
CALL GITUDT.ADD(REPO, S)
$ENDIF
RETURN