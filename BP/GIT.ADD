/**
 * @file GIT.ADD
 * @version 4.1
 */
SUBROUTINE GIT.ADD
S = TRIM(SENTENCE())
A = FIELD(S, " ", 3)
IF A = "DICT" THEN
   FN = FIELD(S, " ", 4):".DICT"
   ID = FIELD(S, " ", 5)
END ELSE
   FN = A
   ID = FIELD(S, " ", 4)
END
IF FN = ".DICT" OR FN = "" THEN
   PRINT "usage: GIT ADD {DICT} file {record}"
   RETURN
END
OUT = ""
CALL GITADD(".recgit", FN, ID, OUT)
PRINT OUT
RETURN
