* /**
*  * @file GIT.CMD.NARGS
*  * @version 1.0
*  */
SUBROUTINE GIT.CMD.NARGS(CNT)
COMMON /GETOPT/ GO.NAMES, GO.VALS, GO.HAS, GO.ARGS, GO.ERR
IF GO.ARGS = "" THEN CNT = 0 ELSE CNT = DCOUNT(GO.ARGS, @AM)
RETURN