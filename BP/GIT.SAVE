/**
 * @file GIT.SAVE
 * @version 1.0
 */
* GIT SAVE file {message} — commit the file's records directly.
SUBROUTINE GIT.SAVE
S = TRIM(SENTENCE())
FN = FIELD(S, " ", 3)
MSG = FIELD(S, " ", 4, 99)
IF FN = "" THEN
   PRINT "usage: GIT SAVE file {message}"
   RETURN
END
IF MSG = "" THEN MSG = "save ":FN
OUT = ""
CALL GITSAVE(".recgit", FN, MSG, OUT)
PRINT OUT
RETURN
