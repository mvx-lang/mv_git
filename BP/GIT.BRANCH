* /**
*  * @file GIT.BRANCH
*  * @version 1.0
*  */
SUBROUTINE GIT.BRANCH
CALL GIT.SENT(S)
NM = FIELD(S, " ", 3)
$IFDEF MVX
OUT = ""
CALL GITBRANCH(".git", NM, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
DIM AV(8) ; MAT AV = ""            ;* argument vector for GIT.OBJ
REPO = @PATH : "/.git"
AV(1) = REPO ; AV(2) = NM
CALL GIT.OBJ("BRANCH", MAT AV, 2, OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN