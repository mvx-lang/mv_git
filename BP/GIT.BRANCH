* /**
*  * @file GIT.BRANCH
*  * @version 1.0
*  */
SUBROUTINE GIT.BRANCH
CALL GIT.SENT(S)
NM = FIELD(S, " ", 3)
$IFDEF MVX
GOUT = ""
CALL GITBRANCH(".git", NM, GOUT)
FOR I = 1 TO DCOUNT(GOUT, @AM)
   PRINT GOUT<I>
NEXT I
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("BRANCH", 2, REPO, NM, "", "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN