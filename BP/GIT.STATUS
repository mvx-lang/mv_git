* /**
*  * @file GIT.STATUS
*  * @version 4.0
*  */
SUBROUTINE GIT.STATUS
      $INCLUDE BP.INC PLATFORM.H
* The include is REQUIRED now, and was not before.  This handler used to be a
* two-way IFDEF MVX / ELSE / ENDIF, and that form runs its ELSE arm whether
* or not any define is in scope — so it worked without ever including
* PLATFORM.H.  Inlining the helper below keeps the two-way shape, but the file
* now DEPENDS on the define being right rather than merely preferring it, and a
* handler that silently compiles to nothing is the failure that cost an
* afternoon on GIT CLONE (mv_git#52).  DECISIONS.md records the rule.
$IFDEF MVX
OUT = ""
CALL GITSTATUS(".git", OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
* Inlined from GITUDT.STATUS, which had exactly one caller — this one.
REPO = ""
CALL GIT.REPO(REPO)
   AM = CHAR(254) ; LF = CHAR(10)
   FCTL = ".DICT/%FILE%" ; LC = LEN(FCTL) ; NCH = 0
*  STAGED FIRST — what the index holds that HEAD does not.
*
*  This walk compares the paths git HOLDS against the live records, which can
*  see a record change or a record vanish but never sees the index.  So anything
*  staged with no backing record to compare against — a %FILE% control, the
*  account descriptor — was invisible here and visible on MVX, whose C status
*  has always had this section, for the same repository.  An attribute edit is
*  exactly that kind of change, and a status that stayed clean after one is the
*  worst possible answer: it reads as "the edit did not happen".
   STG = ""
   CALL GIT.OBJ("STAGED", 1, REPO, "", "", "", "", STG)
   NSG = DCOUNT(STG, AM)
   FOR SGI = 1 TO NSG
      IF STG<SGI> # "" THEN
         PRINT STG<SGI>
         NCH += 1
      END
   NEXT SGI
   PATHS = ""
   CALL GIT.OBJ("FILES", 1, REPO, "", "", "", "", PATHS)
   NP = DCOUNT(PATHS, AM)
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      BEGIN CASE
      CASE P = ".mv-account" OR P = ".udt" OR P = ".mvx"
         NULL
      CASE LP > LC AND P[LP-LC+1, LC] = FCTL
         BASE = P[1, LP-LC] ; GOSUB CTLSTAT
         IF CHG THEN PRINT " M " : P ; NCH += 1
      CASE 1
         SL = INDEX(P, "/", 1)
         IF SL > 0 THEN
            FN = P[1, SL-1] ; RID = P[SL+1, LP]
            CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", CB)
            GOSUB OPENREC
            IF ROK THEN
               READ LV FROM RV, RID THEN
                  GOSUB SAMEREC
                  IF NOT(SAME) THEN PRINT " M " : P ; NCH += 1
               END ELSE
                  PRINT " D " : P ; NCH += 1
               END
            END ELSE
               PRINT " D " : P ; NCH += 1
            END
         END
      END CASE
   NEXT I
   GOSUB UNTRACKED
   IF NCH = 0 THEN PRINT "nothing to commit, working tree clean"
   RETURN
*  Records the account HAS that git does NOT (mv_git#59).
*
*  The pass above walks the paths git holds, so it can see a record change or
*  vanish but can never see one APPEAR — a new record was reported by nothing,
*  on every session platform, and the suite never asked.  (The engine's own C
*  status has always reported these; this arm is the one the in-session verb
*  runs, and it simply never had the case.)
*
*  Same exclusions `add` applies, and for the same reason: reporting something
*  no wholesale add will ever stage leaves it untracked forever.  Stock records
*  are the account's furniture (mv_git#46), compiled objects are "_<PROG>"
*  beside their source, and the %FILE% / %INDEXES% controls are synthesised
*  rather than stored.
UNTRACKED:
*  The same furniture ids `add` uses, from the same place — or status reports
*  `?? VOC/_HOLD_` for records add will never stage, and the account can never
*  read clean (mv_git#78).
   UFURN = ""
   UCAND = ""
   OPEN "VOC" TO UVOCF THEN
*     The same spelling as the select below, which is the one all three
*     compilers take — a bare SELECT with LOOP WHILE READNEXT does not.
      UVLIST = ""
      SELECT UVOCF TO UVLIST
      LOOP
         READNEXT UVID FROM UVLIST ELSE EXIT
         READ UVREC FROM UVOCF, UVID THEN
            UVT = TRIM(FIELD(UVREC<1>, " ", 1))
            IF UVT = "F" OR UVT = "DIR" THEN UCAND<-1> = UVID : VM : UVT
         END
      REPEAT
   END
   CALL GIT.FURNIDS(REPO, UCAND, UFURN)
   UFILES = ""
   NP2 = DCOUNT(PATHS, AM)
   FOR U = 1 TO NP2
      UP = PATHS<U> ; USL = INDEX(UP, "/", 1)
      IF USL > 0 THEN
         UFN = UP[1, USL-1]
         UFDROP = 0
         IF UFURN # "" THEN LOCATE(UFN, UFURN; UFNP) THEN UFDROP = 1
         IF NOT(UFDROP) THEN
            IF INDEX(AM : UFILES : AM, AM : UFN : AM, 1) = 0 THEN UFILES<-1> = UFN
         END
      END
   NEXT U
*  The account's own GIT IGNORE list, read through the same seam GIT.IGNORE
*  writes it with (OSREAD/OSWRITE are UniData-only).  `add` skips these, so
*  reporting them would leave them untracked forever — the same rule every
*  other exclusion here follows.
   IGL = ""
   CALL GIT.OSFILE("READ", @PATH : "/GITIGNORE", IGL, IGOK)
   IF NOT(IGOK) THEN IGL = ""
   CONVERT LF TO AM IN IGL
*  And git's OWN .gitignore, which is a separate list from the account's bulk
*  GIT IGNORE one and is what an ordinary user reaches for first.  Full
*  gitignore semantics live in the engine (libgit2); this honours the plain
*  forms — an exact path, a file name, a trailing "*" — which is what the
*  records path actually uses.
   IGL2 = ""
   CALL GIT.OSFILE("READ", @PATH : "/.gitignore", IGL2, IG2OK)
   IF IG2OK AND IGL2 # "" THEN
      CONVERT LF TO AM IN IGL2
      IF IGL = "" THEN IGL = IGL2 ELSE IGL := AM : IGL2
   END
   SPATH = ""
   CALL GIT.STOCK(REPO, SPATH)
   USTK = 0
   IF SPATH # "" THEN
      OPEN "VOC" TO UVOC THEN
         USP = ""
         USP<1> = "F"
         USP<2> = FIELD(SPATH, CHAR(254), 1)
         USP<3> = FIELD(SPATH, CHAR(254), 2)
         WRITE USP ON UVOC, "%GITSTOCK%"
         OPEN "%GITSTOCK%" TO USTKF THEN USTK = 1
      END
   END
   NU = DCOUNT(UFILES, AM)
   FOR U = 1 TO NU
      FN = UFILES<U>
      UISVOC = (FN = "VOC" OR FN = "MD")
      GOSUB OPENREC
      IF ROK THEN
*        A select-list VARIABLE, not a numbered list, and the LOOP/ELSE EXIT
*        form: UniVerse rejects "SELECT x TO 6" ("option 'S' requires variable
*        name") and will not parse "LOOP WHILE READNEXT ... DO".  Both platforms
*        accept this spelling — the same one GITUDT.CHECKOUT settled on.
         * The list variable is an OUTPUT of SELECT, but UniData still reads it first:
         * left unassigned it prints "UNINITIALIZED VARIABLE USED! Zero Assumed!" into
         * the middle of the verb's own output, which reads as a fault in whatever the
         * user just ran.
         ULIST = ""
         SELECT RV TO ULIST
         LOOP
            READNEXT URID FROM ULIST ELSE EXIT
            UPATH = FN : "/" : URID
            IF INDEX(AM : PATHS : AM, AM : UPATH : AM, 1) = 0 THEN
               UDROP = 0
               IF URID = "%FILE%" OR URID = "%INDEXES%" THEN UDROP = 1
               IF URID = "%GITSTOCK%" THEN UDROP = 1
*              An id git cannot store as a path is never staged (mv_git#42), so
*              reporting it would leave it untracked forever.  UniVerse VOCs
*              really do carry one: a record whose id is "/".
               IF URID = "" OR INDEX(URID, "/", 1) > 0 THEN UDROP = 1
               NIG = DCOUNT(IGL, AM)
               FOR G = 1 TO NIG
                  GP = TRIM(IGL<G>)
                  IF GP # "" THEN
*                    Exact path, bare file name, or a "FILE/" prefix — the
*                    forms the list actually holds.  Not fnmatch: BASIC has no
*                    pattern matcher, and the engine applies the full rules on
*                    its own paths.
                     IF GP = UPATH OR GP = FN THEN UDROP = 1
                     GL = LEN(GP)
                     IF GP[GL,1] = "*" THEN
                        IF UPATH[1, GL-1] = GP[1, GL-1] THEN UDROP = 1
                     END
                  END
               NEXT G
               IF URID[1,1] = "_" THEN
                  READ UOBJ FROM RV, URID[2, LEN(URID)] THEN UDROP = 1
               END
               IF NOT(UDROP) AND UISVOC AND UFURN # "" THEN
                  LOCATE(URID, UFURN; UFPOS) THEN UDROP = 1
               END
               IF NOT(UDROP) AND USTK AND UISVOC THEN
                  READ USREC FROM USTKF, URID THEN UDROP = 1
               END
               IF NOT(UDROP) THEN
                  READ UREC FROM RV, URID THEN
                     IF INDEX(UREC, CHAR(0), 1) > 0 THEN UDROP = 1
                  END ELSE UDROP = 1
               END
               IF NOT(UDROP) THEN
                  PRINT "?? " : UPATH
                  NCH += 1
               END
            END
         REPEAT
         CLEARSELECT
      END
   NEXT U
   IF USTK THEN DELETE UVOC, "%GITSTOCK%"
   RETURN
*  A %FILE% control's CLASS is its FIRST LINE — the lines after it are the
*  registry's `key = value` parameters (mv_git#15), and CAT hands the blob back
*  with newlines already turned into attribute marks, so line 1 is <1>.  Reading
*  the whole blob made every extended control look like neither DIR nor hash.
*
*  Only the class is compared, deliberately: a modulo that moved is a RESIZE,
*  which is local operational tuning and must not read as a change to the thing
*  being versioned (540c066).  Geometry becomes a change only when GIT ATTR says
*  so, and that shows up as a staged edit rather than through here.
CTLSTAT:
   CHG = 0
   CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", CB)
   CCL = TRIM(FIELD(CB<1>, " ", 1))
   IF CCL[1,3] = "DIR" THEN CCL = "DIR" ELSE CCL = "hash"
   FILE = BASE ; GOSUB FILECLASS
   LCL = TRIM(FIELD(CTL<1>, " ", 1))
   IF LCL[1,3] = "DIR" THEN LCL = "DIR" ELSE LCL = "hash"
   IF CCL # LCL THEN CHG = 1
   RETURN
*  One copy of this rule now, in GIT.FILECLASS.
FILECLASS:
   CTL = ""
   CALL GIT.FILECLASS(FILE, CTL)
   RETURN
OPENREC:
   ROK = 0 ; LFN = LEN(FN)
   IF LFN > 5 AND FN[LFN-4, 5] = ".DICT" THEN
      OPEN "DICT", FN[1, LFN-5] TO RV THEN ROK = 1
   END ELSE
      OPEN FN TO RV THEN ROK = 1
   END
   RETURN
SAMEREC:
   IF INDEX(LV, CHAR(0), 1) > 0 THEN SAME = 1 ; RETURN
   GLV = LV ; CONVERT AM TO LF IN GLV
   GCB = CB ; CONVERT AM TO LF IN GCB
   SAME = (GLV = GCB)
   RETURN
$ENDIF
RETURN