* /**
*  * @file GIT.MERGE
*  * @version 1.0
*  */
SUBROUTINE GIT.MERGE
$INCLUDE BP.INC PLATFORM.H
CALL GIT.SENT(S)
NM = FIELD(S, " ", 3)
IF NM = "" THEN
   PRINT "usage: GIT MERGE branch"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITMERGE(".git", NM, GOUT)
FOR I = 1 TO DCOUNT(GOUT, @AM)
   PRINT GOUT<I>
NEXT I
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("MERGE", 2, REPO, NM, "", "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)                ;* the merge result (fast-forward / conflict)
CALL GITUDT.CHECKOUT(REPO)           ;* re-materialise the merged HEAD natively
$ENDIF
RETURN