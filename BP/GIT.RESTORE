* /**
*  * @file GIT.RESTORE
*  * @version 4.1
*  */
SUBROUTINE GIT.RESTORE
$INCLUDE BP.INC PLATFORM.H
CALL GIT.SENT(S)
A = FIELD(S, " ", 3)
IF A = "DICT" THEN
   FN = FIELD(S, " ", 4):".DICT"
END ELSE
   FN = A
END
IF FN = ".DICT" OR FN = "" THEN
   PRINT "usage: GIT RESTORE {DICT} file"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITRESTORE(".git", FN, GOUT)
PRINT GOUT
$ELSE
CALL GIT.REPO(REPO)
CALL GITUDT.RESTORE(REPO, FN)
$ENDIF
RETURN