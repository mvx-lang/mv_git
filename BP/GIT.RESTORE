/**
 * @file GIT.RESTORE
 * @version 4.1
 */
SUBROUTINE GIT.RESTORE
S = TRIM(SENTENCE())
A = FIELD(S, " ", 3)
IF A = "DICT" THEN
   FN = FIELD(S, " ", 4):".DICT"
END ELSE
   FN = A
END
IF FN = ".DICT" OR FN = "" THEN
   PRINT "usage: GIT RESTORE {DICT} file"
   RETURN
END
OUT = ""
CALL GITRESTORE(".recgit", FN, OUT)
PRINT OUT
RETURN
