* /**
*  * @file GIT.RM
*  * @version 4.0
*  */
SUBROUTINE GIT.RM
$INCLUDE BP.INC PLATFORM.H
CALL GIT.SENT(S)
FN = FIELD(S, " ", 3)
ID = FIELD(S, " ", 4)
IF FN = "" THEN
   PRINT "usage: GIT RM file {record}"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITRM(".git", FN, ID, GOUT)
PRINT GOUT
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("RM", 3, REPO, FN, ID, "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN