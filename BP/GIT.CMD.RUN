* /**
*  * @file GIT.CMD.RUN
*  * @version 2.0
*  */
* CMD.RUN — fetch the sentence, dispatch to the matching handler, or print help.
* If the matched subcommand declared flags (CMD.FLAG), parse the sentence against
* them via the getopt package first, then hand the handler the parsed options
* (which it reads with GETOPT.VAL / GETOPT.HAS / GETOPT.ARG).  `--help`/`-h` on a
* subcommand, or `help <sub>`, prints that subcommand's usage.  The sentence is
* fetched through GETOPT.SENTENCE, the one portable seam (SENTENCE()/@SENTENCE).
SUBROUTINE GIT.CMD.RUN
COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS, CFLAGS
CALL GIT.SENT(S)
W = FIELD(S, " ", 2)
WU = OCONV(W, "MCU")
IF WU = "" OR WU = "HELP" THEN
   HS = OCONV(FIELD(S, " ", 3), "MCU")
   IF WU = "HELP" AND HS # "" THEN
      LOCATE(HS, CSUBS; POS) THEN
         WU = HS
         GOSUB 9300
      END ELSE
         PRINT CNAME : ": unknown command '" : FIELD(S, " ", 3) : "'"
         GOSUB 9100
      END
      RETURN
   END
   GOSUB 9100
   RETURN
END
LOCATE(WU, CSUBS; POS) THEN
   GOSUB 9200
   IF SPEC # "" THEN
      IF INDEX(S, " --help", 1) # 0 OR INDEX(S, " -h", 1) # 0 THEN
         GOSUB 9300
         RETURN
      END
      CALL GIT.CMD.PARSE(SPEC, S, 2)
      CALL GIT.CMD.ERR(GERR)
      IF GERR # "" THEN
         PRINT CNAME : " " : OCONV(WU, "MCL") : ": " : GERR
         GOSUB 9300
         RETURN
      END
   END
   H = CHANDLERS<POS>
   CALL @H
END ELSE
   PRINT CNAME : ": unknown command '" : W : "'"
   GOSUB 9100
END
RETURN
*
* 9200 — build SPEC (a getopt spec) for subcommand WU from its declared flags.
9200
SPEC = ""
NF = 0 ; IF CFLAGS # "" THEN NF = DCOUNT(CFLAGS, @AM)
FOR FI = 1 TO NF
   IF CFLAGS<FI, 1> = WU THEN
      CALL GIT.CMD.OPT(SPEC, CFLAGS<FI, 2>, CFLAGS<FI, 3>, CFLAGS<FI, 4>, CFLAGS<FI, 5>, CFLAGS<FI, 6>)
   END
NEXT FI
RETURN
*
* 9300 — per-subcommand usage (WU/POS set on entry; builds SPEC).
9300
GOSUB 9200
PRINT "usage: " : CNAME : " " : OCONV(WU, "MCL") : " [options]"
PRINT "  " : CDESCS<POS>
IF SPEC # "" THEN
   PRINT "options:"
   CALL GIT.CMD.USAGE(SPEC, U)
   NU = DCOUNT(U, @AM)
   FOR UI = 1 TO NU
      PRINT U<UI>
   NEXT UI
END
RETURN
*
* 9100 — top-level help: list the subcommands.
9100
PRINT CNAME : " - " : CDESC
PRINT "usage: " : CNAME : " <command>"
PRINT "commands:"
N = DCOUNT(CSUBS, @AM)
FOR I = 1 TO N
   PRINT "  " : FMT(OCONV(CSUBS<I>, "MCL"), "L#12") : " " : CDESCS<I>
NEXT I
PRINT "  " : FMT("help", "L#12") : " show this help"
RETURN