*  * @version 1.0
*  */
SUBROUTINE GIT.FETCH
CALL GIT.SENT(S)
RNAME = FIELD(S, " ", 3)
$IFDEF MVX
OUT = ""
CALL GITFETCH(".git", RNAME, OUT)
PRINT OUT
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("FETCH", 2, REPO, RNAME, "", "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN