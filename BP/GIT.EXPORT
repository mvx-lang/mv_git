/**
 * @file GIT.EXPORT
 * @version 2.0
 */
* GIT EXPORT file — export a hash file to its directory file and stage
* it (native add, no shell).
SUBROUTINE GIT.EXPORT
FN = FIELD(TRIM(SENTENCE()), " ", 3)
IF FN = "" THEN
   PRINT "usage: GIT EXPORT file"
   RETURN
END
EXECUTE "EXPORT ":FN
ERR = ""
CALL GITADD(".", FN:".EXP", ERR)
IF ERR = "" THEN
   PRINT FN:".EXP staged"
END ELSE
   PRINT ERR
END
RETURN
