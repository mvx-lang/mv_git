/**
 * @file GIT
 * @version 3.0
 */
* GIT — version hash-file records directly (no export copy).  Records
* become git blobs in place; git objects live in a bare repo (.recgit).
CALL CMD.INIT("GIT", "version hash-file records with git")
CALL CMD.ADD("SAVE", "commit a file's records", "GIT.SAVE")
CALL CMD.ADD("RESTORE", "restore a file's records from git", "GIT.RESTORE")
CALL CMD.ADD("LOG", "recent history", "GIT.LOG")
CALL CMD.RUN
