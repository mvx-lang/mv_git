* /**
*  * @file GIT.COMMIT
*  * @version 4.0
*  */
SUBROUTINE GIT.COMMIT
$INCLUDE BP.INC PLATFORM.H
* the message is decoded by the cmd dispatch (GIT.CMD.FLAG "m"/"message"); read it.
CALL GIT.CMD.VAL("m", MSG)
IF MSG = "" THEN
   PRINT "usage: GIT COMMIT -m message"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITCOMMIT(".git", MSG, GOUT)
PRINT GOUT
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("COMMIT", 2, REPO, MSG, "", "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN