/**
 * @file GIT.COMMIT
 * @version 2.0
 */
* GIT COMMIT message... — commit staged changes (native, message not
* interpolated into a shell).
SUBROUTINE GIT.COMMIT
MSG = FIELD(TRIM(SENTENCE()), " ", 3, 99)
IF MSG = "" THEN
   PRINT "usage: GIT COMMIT message"
   RETURN
END
OUT = ""
CALL GITCOMMIT(".", MSG, OUT)
PRINT OUT
RETURN
