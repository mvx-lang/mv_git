* /**
*  * @file GIT.COMMIT
*  * @version 4.0
*  */
SUBROUTINE GIT.COMMIT
* the message is decoded by the cmd dispatch (GIT.CMD.FLAG "m"/"message"); read it.
CALL GIT.CMD.VAL("m", MSG)
IF MSG = "" THEN
   PRINT "usage: GIT COMMIT -m message"
   RETURN
END
$IFDEF MVX
OUT = ""
CALL GITCOMMIT(".git", MSG, OUT)
PRINT OUT
$ELSE
REPO = @PATH : "/.git"
R = CALLC GITCOMMIT(REPO, MSG)
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN