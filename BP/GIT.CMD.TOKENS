* /**
*  * @file GIT.CMD.TOKENS
*  * @version 1.0
*  */
SUBROUTINE GIT.CMD.TOKENS(S, TOKS)
DQ = CHAR(34) ; SQ = CHAR(39)
TOKS = "" ; CUR = "" ; INTOK = 0 ; Q = ""
L = LEN(S)
FOR I = 1 TO L
   C = S[I, 1]
   BEGIN CASE
      CASE Q # ""
         IF C = Q THEN
            Q = ""
         END ELSE
            CUR = CUR : C
         END
         INTOK = 1
      CASE C = DQ OR C = SQ
         Q = C ; INTOK = 1
      CASE C = " "
         IF INTOK THEN
            TOKS<-1> = CUR ; CUR = "" ; INTOK = 0
         END
      CASE 1
         CUR = CUR : C ; INTOK = 1
   END CASE
NEXT I
IF INTOK THEN TOKS<-1> = CUR
RETURN