/**
 * @file GIT.CLONE
 * @version 1.0
 */
SUBROUTINE GIT.CLONE
S = TRIM(SENTENCE())
URL = FIELD(S, " ", 3)
DIR = FIELD(S, " ", 4)
REF = FIELD(S, " ", 5)
IF URL = "" OR DIR = "" THEN
   PRINT "usage: GIT CLONE url dir {ref}"
   RETURN
END
OUT = ""
CALL GITCLONE(URL, DIR, REF, OUT)
PRINT OUT
RETURN