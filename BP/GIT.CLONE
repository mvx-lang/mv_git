* /**
*  * @file GIT.CLONE
*  * @version 1.0
*  */
SUBROUTINE GIT.CLONE
CALL GIT.SENT(S)
URL = FIELD(S, " ", 3)
DIR = FIELD(S, " ", 4)
REF = FIELD(S, " ", 5)
IF URL = "" OR DIR = "" THEN
   PRINT "usage: GIT CLONE url dir {ref}"
   RETURN
END
$IFDEF MVX
OUT = ""
CALL GITCLONE(URL, DIR, REF, OUT)
PRINT OUT
$ELSE
REPO = @PATH : "/.git"
CALL GIT.OBJ("CLONE", 4, REPO, URL, DIR, REF, "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN