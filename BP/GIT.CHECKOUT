* /**
*  * @file GIT.CHECKOUT
*  * @version 1.0
*  */
SUBROUTINE GIT.CHECKOUT
CALL GIT.SENT(S)
NM = FIELD(S, " ", 3)
$IFDEF MVX
IF NM = "" THEN
   PRINT "usage: GIT CHECKOUT branch"
   RETURN
END
OUT = ""
CALL GITCHECKOUT(".git", NM, OUT)
PRINT OUT
$ELSE
CALL GIT.REPO(REPO)
IF NM # "" THEN
   CALL GIT.OBJ("SWITCH", 2, REPO, NM, "", "", "", OBJOUT)             ;* move HEAD to the branch (git side)
   MSG = OBJOUT
   PRINT MSG
   IF MSG[1, 8] # "switched" THEN RETURN     ;* no such branch — HEAD unchanged
END
CALL GITUDT.CHECKOUT(REPO)                   ;* re-materialise the (new) HEAD natively
$ENDIF
RETURN