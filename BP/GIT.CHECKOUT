* /**
*  * @file GIT.CHECKOUT
*  * @version 1.0
*  */
SUBROUTINE GIT.CHECKOUT
CALL GIT.SENT(S)
NM = FIELD(S, " ", 3)
$IFDEF MVX
IF NM = "" THEN
   PRINT "usage: GIT CHECKOUT branch"
   RETURN
END
OUT = ""
CALL GITCHECKOUT(".git", NM, OUT)
PRINT OUT
$ELSE
PERFORM "UDT.OPTIONS 88 ON"
REPO = @PATH : "/.git"
CALL GITUDT.CHECKOUT(REPO)
$ENDIF
RETURN