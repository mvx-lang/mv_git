* /**
*  * @file GITUDT.SHOW
*  * @version 1.0
*  */
* GITUDT.SHOW(repo) — print the git-object output the CallC funcs leave in
* <repo>/gitmsg (their string return does not marshal), one @AM line per PRINT.
* UDT-only; on MVX the engine returns output directly, so the body is skipped.
SUBROUTINE GITUDT.SHOW(REPO)
$IFNDEF MVX
   AM = CHAR(254)
   OSREAD MSGT FROM REPO : "/gitmsg" ELSE MSGT = ""
   IF MSGT # "" THEN
      NL = DCOUNT(MSGT, AM)
      FOR I = 1 TO NL
         PRINT MSGT<I>
      NEXT I
   END
$ENDIF
RETURN