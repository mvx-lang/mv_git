* mv_git — record-git for MultiValue.
* Copyright (C) 2026 Gordon Heydon.
*
* SPDX-License-Identifier: GPL-2.0-only
* /**
*  * @file GITUDT.STATUS
*  * @version 1.0
*  */
* GITUDT.STATUS(repo) — the UniData (Model B) STATUS: compare the live records
* against HEAD on the current session.  GITFILES lists HEAD's blob paths; GITCAT
* gives the committed record, a native READ the working one — a plain string
* compare (marks folded to newlines) classifies modified (M) / deleted (D).  The
* %FILE% control compares by CLASS only (the modulo is a sticky default, mvx#8).
SUBROUTINE GITUDT.STATUS(REPO)
$IFNDEF MVX
   DIM AV(8) ; MAT AV = ""   ;* argument vector for GIT.OBJ
   AM = CHAR(254) ; LF = CHAR(10)
   FCTL = ".DICT/%FILE%" ; LC = LEN(FCTL) ; NCH = 0
   AV(1) = REPO
   CALL GIT.OBJ("FILES", MAT AV, 1, PATHS)
   NP = DCOUNT(PATHS, AM)
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      BEGIN CASE
      CASE P = ".mv-account" OR P = ".udt" OR P = ".mvx"
         NULL
      CASE LP > LC AND P[LP-LC+1, LC] = FCTL
         BASE = P[1, LP-LC] ; GOSUB CTLSTAT
         IF CHG THEN PRINT " M " : P ; NCH += 1
      CASE 1
         SL = INDEX(P, "/", 1)
         IF SL > 0 THEN
            FN = P[1, SL-1] ; RID = P[SL+1, LP]
            AV(1) = REPO ; AV(2) = P
            CALL GIT.OBJ("CAT", MAT AV, 2, CB)
            GOSUB OPENREC
            IF ROK THEN
               READ LV FROM RV, RID THEN
                  GOSUB SAMEREC
                  IF NOT(SAME) THEN PRINT " M " : P ; NCH += 1
               END ELSE
                  PRINT " D " : P ; NCH += 1
               END
            END ELSE
               PRINT " D " : P ; NCH += 1
            END
         END
      END CASE
   NEXT I
   IF NCH = 0 THEN PRINT "nothing to commit, working tree clean"
   RETURN
CTLSTAT:
   CHG = 0
   AV(1) = REPO ; AV(2) = P
   CALL GIT.OBJ("CAT", MAT AV, 2, CB)
   CCL = TRIM(FIELD(CB, " ", 1))
   IF CCL[1,3] = "DIR" THEN CCL = "DIR" ELSE CCL = "hash"
   FILE = BASE ; GOSUB FILECLASS
   LCL = TRIM(FIELD(CTL, " ", 1))
   IF LCL[1,3] = "DIR" THEN LCL = "DIR" ELSE LCL = "hash"
   IF CCL # LCL THEN CHG = 1
   RETURN
FILECLASS:
   CTL = "hash"
   OPEN FILE TO FCVAR THEN
      FTY = FILEINFO(FCVAR, 3) ; MODL = FILEINFO(FCVAR, 5)
      IF MODL <= 0 THEN
         CTL = "DIR"
      END ELSE
         IF FTY = 2 THEN DS = "STATIC" ELSE DS = "DYNAMIC"
         CTL = "hash " : MODL : " " : DS
      END
   END
   RETURN
OPENREC:
   ROK = 0 ; LFN = LEN(FN)
   IF LFN > 5 AND FN[LFN-4, 5] = ".DICT" THEN
      OPEN "DICT", FN[1, LFN-5] TO RV THEN ROK = 1
   END ELSE
      OPEN FN TO RV THEN ROK = 1
   END
   RETURN
SAMEREC:
   IF INDEX(LV, CHAR(0), 1) > 0 THEN SAME = 1 ; RETURN
   GLV = LV ; CONVERT AM TO LF IN GLV
   GCB = CB ; CONVERT AM TO LF IN GCB
   SAME = (GLV = GCB)
   RETURN
$ENDIF
RETURN