* /**
*  * @file GIT.CONFIG
*  * @version 1.0
*  */
SUBROUTINE GIT.CONFIG
CALL GIT.SENT(S)
KEY = FIELD(S, " ", 3)
* value = everything after the key (so user.name "Gordon Heydon" keeps its space)
VAL = FIELD(S, " ", 4, 99)
IF KEY = "" THEN
   PRINT "usage: GIT CONFIG key {value}"
   RETURN
END
$IFDEF MVX
OUT = ""
CALL GITCONFIG(".git", KEY, VAL, OUT)
PRINT OUT
$ELSE
PERFORM "UDT.OPTIONS 88 ON"  ;* once per invocation; better: enable in the login PROC (mv_git#25)
REPO = @PATH : "/.git"
R = CALLC GITCONFIG(REPO, KEY, VAL)
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN