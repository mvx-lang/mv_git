* /**
*  * @file GIT.CONFIG
*  * @version 1.0
*  */
SUBROUTINE GIT.CONFIG
CALL GIT.SENT(S)
GKEY = FIELD(S, " ", 3)
* value = everything after the key (so user.name "Gordon Heydon" keeps its space)
VAL = FIELD(S, " ", 4, 99)
IF GKEY = "" THEN
   PRINT "usage: GIT CONFIG key {value}"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITCONFIG(".git", GKEY, VAL, GOUT)
PRINT GOUT
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("CONFIG", 3, REPO, GKEY, VAL, "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN