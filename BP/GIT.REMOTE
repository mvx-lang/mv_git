* /**
*  * @file GIT.REMOTE
*  * @version 1.0
*  */
SUBROUTINE GIT.REMOTE
CALL GIT.SENT(S)
ACT = FIELD(S, " ", 3)
NM = FIELD(S, " ", 4)
URL = FIELD(S, " ", 5)
$IFDEF MVX
OUT = ""
CALL GITREMOTE(".git", ACT, NM, URL, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
PERFORM "UDT.OPTIONS 88 ON"  ;* once per invocation; better: enable in the login PROC (mv_git#25)
REPO = @PATH : "/.git"
R = CALLC GITREMOTE(REPO, ACT, NM, URL)
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN