/**
 * @file GIT.REMOTE
 * @version 1.0
 */
SUBROUTINE GIT.REMOTE
S = TRIM(SENTENCE())
ACT = FIELD(S, " ", 3)
NM = FIELD(S, " ", 4)
URL = FIELD(S, " ", 5)
OUT = ""
CALL GITREMOTE(".git", ACT, NM, URL, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
RETURN