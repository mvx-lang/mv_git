* /**
*  * @file GIT.REMOTE
*  * @version 1.0
*  */
SUBROUTINE GIT.REMOTE
CALL GIT.SENT(S)
ACT = FIELD(S, " ", 3)
NM = FIELD(S, " ", 4)
URL = FIELD(S, " ", 5)
$IFDEF MVX
GOUT = ""
CALL GITREMOTE(".git", ACT, NM, URL, GOUT)
FOR I = 1 TO DCOUNT(GOUT, @AM)
   PRINT GOUT<I>
NEXT I
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("REMOTE", 4, REPO, ACT, NM, URL, "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN