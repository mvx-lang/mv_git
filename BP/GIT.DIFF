SUBROUTINE GIT.DIFF
      $INCLUDE BP.INC PLATFORM.H
* The include is REQUIRED now, and was not before: the two-way $IFDEF MVX /
* $ELSE / $ENDIF runs its $ELSE arm whether or not any define is in scope, so
* this file worked without ever including PLATFORM.H.  Inlining keeps that shape
* but makes the define load-bearing, and a handler that silently compiles to
* nothing is what cost an afternoon on GIT CLONE (mv_git#52).
CALL GIT.SENT(S)
FN = FIELD(S, " ", 3)
$IFDEF MVX
OUT = ""
CALL GITDIFF(".git", FN, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
* Inlined from GITUDT.DIFF, which had exactly one caller — this one.  Its
* parameter was named DFILE; bind it rather than rename through the body, so the
* code below stays byte-identical to what was verified.
CALL GIT.REPO(REPO)
DFILE = FN
   AM = CHAR(254) ; LF = CHAR(10)
   FCTL = ".DICT/%FILE%" ; LC = LEN(FCTL) ; NDF = 0
   CALL GIT.OBJ("FILES", 1, REPO, "", "", "", "", PATHS)
   NP = DCOUNT(PATHS, AM)
   FOR I = 1 TO NP
      P = PATHS<I> ; LP = LEN(P)
      IF P = ".mv-account" OR P = ".udt" OR P = ".mvx" THEN GOTO NEXTD
      IF LP > LC AND P[LP-LC+1, LC] = FCTL THEN GOTO NEXTD
      SL = INDEX(P, "/", 1) ; IF SL = 0 THEN GOTO NEXTD
      FN = P[1, SL-1] ; RID = P[SL+1, LP]
      IF DFILE # "" AND FN # DFILE THEN GOTO NEXTD
      CALL GIT.OBJ("CAT", 2, REPO, P, "", "", "", CB)
      GOSUB OPENREC ; LV = ""
      IF ROK THEN
         READ LV FROM RV, RID ELSE LV = ""
      END
      GOSUB SAMEREC
      IF NOT(SAME) THEN
         PRINT "diff " : P
         NAT = DCOUNT(CB, AM) ; NBT = DCOUNT(LV, AM)
         MX = NAT ; IF NBT > MX THEN MX = NBT
         FOR A = 1 TO MX
            OA = CB<A> ; NW = LV<A>
            IF OA # NW THEN
               IF OA # "" THEN PRINT "-" : OA
               IF NW # "" THEN PRINT "+" : NW
            END
         NEXT A
         NDF += 1
      END
   NEXTD:
   NEXT I
   IF NDF = 0 THEN PRINT "no changes"
   RETURN
OPENREC:
   ROK = 0 ; LFN = LEN(FN)
   IF LFN > 5 AND FN[LFN-4, 5] = ".DICT" THEN
      OPEN "DICT", FN[1, LFN-5] TO RV THEN ROK = 1
   END ELSE
      OPEN FN TO RV THEN ROK = 1
   END
   RETURN
SAMEREC:
   IF INDEX(LV, CHAR(0), 1) > 0 THEN SAME = 1 ; RETURN
   GLV = LV ; CONVERT AM TO LF IN GLV
   GCB = CB ; CONVERT AM TO LF IN GCB
   SAME = (GLV = GCB)
   RETURN
$ENDIF
RETURN