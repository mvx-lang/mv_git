/**
 * @file GIT.DIFF
 * @version 4.0
 */
SUBROUTINE GIT.DIFF
FN = FIELD(TRIM(SENTENCE()), " ", 3)
OUT = ""
CALL GITDIFF(".recgit", FN, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
RETURN
