SUBROUTINE GIT.DIFF
CALL GIT.SENT(S)
FN = FIELD(S, " ", 3)
$IFDEF MVX
OUT = ""
CALL GITDIFF(".git", FN, OUT)
FOR I = 1 TO DCOUNT(OUT, @AM)
   PRINT OUT<I>
NEXT I
$ELSE
PERFORM "UDT.OPTIONS 88 ON"  ;* once per invocation; better: enable in the login PROC (mv_git#25)
REPO = @PATH : "/.git"
CALL GITUDT.DIFF(REPO, FN)
$ENDIF
RETURN