* /**
*  * @file GIT.CMD.ARG
*  * @version 1.0
*  */
SUBROUTINE GIT.CMD.ARG(N, VAL)
COMMON /GETOPT/ GO.NAMES, GO.VALS, GO.HAS, GO.ARGS, GO.ERR
VAL = ""
IF GO.ARGS = "" THEN RETURN
IF N >= 1 AND N <= DCOUNT(GO.ARGS, @AM) THEN VAL = GO.ARGS<N>
RETURN