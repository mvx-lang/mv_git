* /**
*  * @file GIT.PUSH
*  * @version 1.0
*  */
SUBROUTINE GIT.PUSH
CALL GIT.SENT(S)
REM = FIELD(S, " ", 3)
SPEC = FIELD(S, " ", 4)
$IFDEF MVX
OUT = ""
CALL GITPUSH(".git", REM, SPEC, OUT)
PRINT OUT
$ELSE
DIM AV(8) ; MAT AV = ""            ;* argument vector for GIT.OBJ
REPO = @PATH : "/.git"
AV(1) = REPO ; AV(2) = REM ; AV(3) = SPEC
CALL GIT.OBJ("PUSH", MAT AV, 3, OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN