/**
 * @file GIT.PUSH
 * @version 1.0
 */
SUBROUTINE GIT.PUSH
S = TRIM(SENTENCE())
REM = FIELD(S, " ", 3)
SPEC = FIELD(S, " ", 4)
OUT = ""
CALL GITPUSH(".git", REM, SPEC, OUT)
PRINT OUT
RETURN