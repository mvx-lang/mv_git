* /**
*  * @file GIT.PUSH
*  * @version 1.0
*  */
SUBROUTINE GIT.PUSH
CALL GIT.SENT(S)
* RNAME, not REM: REM is UniData's REMAINDER FUNCTION, so `REM = FIELD(...)`
* does not assign a variable there — the name reads back as 0, and push reported
* "remote '0' does not exist" with an uninitialised-variable warning as its only
* clue.  UniVerse and MVX accept REM as a variable, so this compiled and ran
* everywhere except the one platform that has the function.  Same trap as OFF in
* GIT.AGENT (BOFF).
RNAME = FIELD(S, " ", 3)
SPEC = FIELD(S, " ", 4)
$IFDEF MVX
GOUT = ""
CALL GITPUSH(".git", RNAME, SPEC, GOUT)
PRINT GOUT
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("PUSH", 3, REPO, RNAME, SPEC, "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN