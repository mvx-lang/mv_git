SUBROUTINE GIT.PUSH
CALL GIT.SENT(S)
REM = FIELD(S, " ", 3)
SPEC = FIELD(S, " ", 4)
$IFDEF MVX
OUT = ""
CALL GITPUSH(".git", REM, SPEC, OUT)
PRINT OUT
$ELSE
REPO = @PATH : "/.git"
R = CALLC GITPUSH(REPO, REM, SPEC)
CALL GITUDT.SHOW(REPO)
$ENDIF
RETURN