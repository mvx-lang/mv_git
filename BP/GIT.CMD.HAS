* /**
*  * @file GIT.CMD.HAS
*  * @version 1.0
*  */
SUBROUTINE GIT.CMD.HAS(NAME, ISON)
COMMON /GETOPT/ GO.NAMES, GO.VALS, GO.HAS, GO.ARGS, GO.ERR
ISON = 0 ; N = 0 ; IF GO.NAMES # "" THEN N = DCOUNT(GO.NAMES, @AM)
FOR I = 1 TO N
   IF GO.NAMES<I,1> = NAME OR GO.NAMES<I,2> = NAME THEN
      ISON = GO.HAS<I>
      RETURN
   END
NEXT I
RETURN