* /**
*  * @file GIT.SHOW
*  * @version 4.0
*  */
SUBROUTINE GIT.SHOW
$INCLUDE BP.INC PLATFORM.H
CALL GIT.SENT(S)
FN = FIELD(S, " ", 3)
ID = FIELD(S, " ", 4)
IF FN = "" OR ID = "" THEN
   PRINT "usage: GIT SHOW file record"
   RETURN
END
$IFDEF ENGINE
GOUT = ""
CALL GITSHOW(".git", FN, ID, GOUT)
FOR I = 1 TO DCOUNT(GOUT, @AM)
   PRINT GOUT<I>
NEXT I
$ELSE
CALL GIT.REPO(REPO)
CALL GIT.OBJ("SHOW", 3, REPO, FN, ID, "", "", OBJOUT)
CALL GIT.ECHO(OBJOUT)
$ENDIF
RETURN