*
* Bundled fallback copy of cmd so git runs standalone.  When the full mv_cmd
* is installed its catalog entry overrides this copy (UniData: a global
* CATALOG overwrite; mvx: the account LIB loads before a package library), so
* GIT calls CMD.* normally and gets whichever is present.
* /**
*  * @file CMD.RUN
*  * @version 1.0
*  */
* CMD.RUN — parse the sentence, dispatch to the matching handler,
* or print generated help.
SUBROUTINE CMD.RUN
COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS
$IFDEF MVX
   S = TRIM(SENTENCE())
$ELSE
   S = TRIM(@SENTENCE)
$ENDIF
W = FIELD(S, " ", 2)
WU = OCONV(W, "MCU")
IF WU = "" OR WU = "HELP" THEN
   GOSUB 9100
   RETURN
END
LOCATE(WU, CSUBS; POS) THEN
   H = CHANDLERS<POS>
   CALL @H
END ELSE
   PRINT CNAME:": unknown command '":W:"'"
   GOSUB 9100
END
RETURN
* generated help
9100
PRINT CNAME:" - ":CDESC
PRINT "usage: ":CNAME:" <command>"
PRINT "commands:"
N = DCOUNT(CSUBS, @AM)
FOR I = 1 TO N
   PRINT "  ":FMT(OCONV(CSUBS<I>, "MCL"), "L#12"):" ":CDESCS<I>
NEXT I
PRINT "  ":FMT("help", "L#12"):" show this help"
RETURN