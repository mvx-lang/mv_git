*
* Minimal cmd bundled with git so it runs standalone (compiled by default).
* GIT redirects CMD.* here via $DEFINE; build GIT with -D FULLCMD to use the
* full mv_cmd (CMD.*) instead.
* /**
*  * @file CMD.ADD
*  * @version 1.0
*  */
* CMD.ADD(subcommand, description, handler-subroutine)
SUBROUTINE CMD.MIN.ADD(SUB, DESC, HANDLER)
COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS
CSUBS<-1> = OCONV(SUB, "MCU")
CDESCS<-1> = DESC
CHANDLERS<-1> = HANDLER
RETURN
