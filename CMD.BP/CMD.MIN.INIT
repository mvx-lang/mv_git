*
* Minimal cmd bundled with git so it runs standalone (compiled by default).
* GIT redirects CMD.* here via $DEFINE unless HAVE_CMD is defined (mkpkg
* defines it when the full mv_cmd is available), which binds the full CMD.*.
* /**
*  * @file CMD.INIT
*  * @version 1.0
*  */
* CMD.INIT(name, description) — begin defining a command.
SUBROUTINE CMD.MIN.INIT(NAME, DESC)
COMMON /CMDPKG/ CNAME, CDESC, CSUBS, CDESCS, CHANDLERS
CNAME = NAME
CDESC = DESC
CSUBS = ""
CDESCS = ""
CHANDLERS = ""
RETURN
